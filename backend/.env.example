# Backend Environment Configuration
PORT=8000
HOST=0.0.0.0

# AI & LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio SMS Configuration
TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=your_twilio_phone_number
USER_PHONE=your_target_phone_number

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# Hugging Face Hub — for large ML model downloads at startup
# Create a free account at https://huggingface.co and upload your models
# Format: "your-hf-username/your-model-repo-name"
HF_REPO_ID=your-hf-username/kishanmitra-models
